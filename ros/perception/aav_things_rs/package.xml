<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aav_things_rs</name>
  <version>0.1.0</version>
  <description>things in Rust (rclrs): a drop-in for aav_things' Python node (navigation.launch.py things_impl:=rust). The same topics, QoS, parameters and answers: /perception/voxels/cubes, the radar's clusters, /map or the NDT chunks, the cameras' boxes in; /world/things and its markers out. The maths is the things-core crate, with no ROS.</description>
  <maintainer email="aav-team@todo.invalid">AAV 2026-27 team</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- rclrs links rcl; ros-env compiles the Rust message code these packages ship. -->
  <depend>rcl</depend>
  <depend>builtin_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>aav_interfaces</depend>


  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_cmake_test</test_depend>
  <test_depend>python3-numpy</test_depend>
  <test_depend>sensor_msgs_py</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
