<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aav_voxels_rs</name>
  <version>0.1.0</version>
  <description>voxels in Rust (rclrs): a drop-in for aav_voxels' Python node (navigation.launch.py voxels_impl:=rust). The same topics, QoS and answers: /sensors/lidar/points in; 0.25 m cubes over the fitted road on /perception/voxels/cubes, the road it saw on /perception/voxels/ground, and /perception/voxels/status out. The maths is the voxels crate, with no ROS.</description>
  <maintainer email="aav-team@todo.invalid">AAV 2026-27 team</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- rclrs links rcl; ros-env compiles the Rust message code these packages ship. -->
  <depend>rcl</depend>
  <depend>builtin_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>nav_msgs</depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_cmake_test</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <!-- The node test plays the Python node's own lot cloud, and compares with cubes.py. -->
  <test_depend>aav_voxels</test_depend>
  <test_depend>aav_lidar</test_depend>
  <test_depend>python3-numpy</test_depend>
  <test_depend>sensor_msgs_py</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
