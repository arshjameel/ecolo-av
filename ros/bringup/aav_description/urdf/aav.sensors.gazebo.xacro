<?xml version="1.0"?>
<!--
  The Gazebo car's three cameras and radar stand-in, and Gazebo's truth: included when sim:=true.
  Each sensor sits at the URDF's own frame (vehicle.yaml), and its messages carry that
  frame, as the real devices' do. Only a world with the Sensors system renders them (the
  road world); elsewhere they cost nothing. Element names checked against gz-sim 8 and
  gz-sensors 8 (Harmonic). Bridged to ROS by aav_gazebo/config/bridge_road.yaml:

    /aav/camera/image         gz.msgs.Image          -> /sensors/camera/front_left/image_raw
    /aav/camera/camera_info   gz.msgs.CameraInfo     -> /sensors/camera/front_left/camera_info
    /aav/camera_right/...     the same               -> /sensors/camera/front_right/...
    /aav/camera_rear/...      the same               -> /sensors/camera/rear/...
    /aav/radar/points         gz.msgs.PointCloudPacked -> /sensors/radar/points (best effort)
    /model/aav/truth          gz.msgs.Odometry       -> /vehicle/gazebo/truth

  With lidar:=true, a roof lidar too, bridged by aav_gazebo/config/bridge_lidar.yaml:

    /aav/lidar/points         gz.msgs.PointCloudPacked -> /sensors/lidar/points

  With chase_camera:=true, a camera behind and above the car, bridged by
  aav_gazebo/config/bridge_chase.yaml (for tools/foxglove/cockpit.json):

    /aav/chase_camera/image   gz.msgs.Image          -> /vehicle/gazebo/chase_camera/image_raw
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- The front camera: the 2024-25 calibration (aav_sensors/config/cameras/left.ini,
       1920 x 1080, fx 1030 px, so 86 degrees across) at a third of its size, as the
       bench camera has it (aav_bench/config/bench.yaml: 640 x 360, focal 343 px). The
       same picture and lens on the bench and here, so stop_sign_watcher's fallback lens
       (focal_px 343: 55 px at 4.7 m) and lane_finder suit both. No lens distortion: the finder ignores it too. -->
  <xacro:property name="camera_width" value="640"/>
  <xacro:property name="camera_height" value="360"/>
  <xacro:property name="camera_focal" value="343.0"/>
  <xacro:macro name="sim_camera" params="link name topic">
    <gazebo reference="${link}">
      <sensor name="${name}" type="camera">
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <topic>${topic}/image</topic>
        <gz_frame_id>${link}</gz_frame_id>
        <camera>
          <camera_info_topic>${topic}/camera_info</camera_info_topic>
          <horizontal_fov>${2 * atan(camera_width / 2.0 / camera_focal)}</horizontal_fov>
          <image>
            <width>${camera_width}</width>
            <height>${camera_height}</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.1</near><far>150</far></clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>
  <!-- The car's three: two up top looking forward, one at the back looking back. All the
       same lens, as the front ones are the same model; the rear one's is unknown (N4). -->
  <xacro:sim_camera link="camera_left_link" name="camera_left" topic="/aav/camera"/>
  <xacro:sim_camera link="camera_right_link" name="camera_right" topic="/aav/camera_right"/>
  <xacro:sim_camera link="camera_rear_link" name="camera_rear" topic="/aav/camera_rear"/>

  <!-- A radar stand-in: a lidar shaped like the TI IWR6843AOP with aav_radar_ti's
       cfg/base.cfg, as the bench's mock_radar is: 8.4 m, 120 degrees wide, a ray every
       2 degrees, 10 Hz, 5 cm of range noise. Three rays up and down, from 1 degree down to
       7 up: the lowest meets the ground 23 m away, well past 8.4 m, so like a radar it sees
       no ground, even as the car pitches. Rays that hit nothing come back as inf, which
       Nav2's costmap and collision_monitor drop. Unlike a radar, it sees every surface,
       and no speeds. -->
  <gazebo reference="radar_link">
    <sensor name="radar" type="gpu_lidar">
      <always_on>1</always_on>
      <update_rate>10</update_rate>
      <topic>/aav/radar</topic>
      <gz_frame_id>radar_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>61</samples>
            <resolution>1</resolution>
            <min_angle>${radians(-60)}</min_angle>
            <max_angle>${radians(60)}</max_angle>
          </horizontal>
          <vertical>
            <samples>3</samples>
            <resolution>1</resolution>
            <min_angle>${radians(-1)}</min_angle>
            <max_angle>${radians(7)}</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.3</min>
          <max>8.4</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.05</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- A roof lidar, with lidar:=true: a generic 16-beam spinning lidar (like a Velodyne
       VLP-16), 360 degrees in 1800 steps (0.2 degrees), 16 beams from 15 degrees down to
       15 up, 0.5-100 m, 3 cm of range noise, 10 Hz. The car has none: it shows what one
       would add. lidar_link and its place come from vehicle.yaml, as every sensor's do.
       Rays that hit nothing come back as inf, which Nav2 and PCL drop. -->
  <xacro:if value="$(arg lidar)">
    <gazebo reference="lidar_link">
      <sensor name="lidar" type="gpu_lidar">
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <topic>/aav/lidar</topic>
        <gz_frame_id>lidar_link</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>1800</samples>
              <resolution>1</resolution>
              <min_angle>${-pi}</min_angle>
              <max_angle>${pi}</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>${radians(-15)}</min_angle>
              <max_angle>${radians(15)}</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.5</min>
            <max>100.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.03</stddev>
          </noise>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:if>

  <!-- A chase camera, with chase_camera:=true: Gazebo's picture of the car, so Lichtblick's
       cockpit layout shows it without Gazebo's window. Fixed to base_link, 7 m behind the
       rear axle and 3.5 m up, looking down 0.28 rad (at the road 5 m ahead of the axle),
       70 degrees across. 640 x 360 at 10 Hz, to cost Gazebo little (docs/foxglove.md).
       No frame of its own: nothing but the cockpit reads it. -->
  <xacro:if value="$(arg chase_camera)">
    <gazebo reference="base_link">
      <sensor name="chase_camera" type="camera">
        <pose>-7.0 0 3.5 0 0.28 0</pose>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <topic>/aav/chase_camera/image</topic>
        <gz_frame_id>base_link</gz_frame_id>
        <camera>
          <horizontal_fov>${radians(70)}</horizontal_fov>
          <image>
            <width>640</width>
            <height>360</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.5</near><far>200</far></clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:if>

  <!-- Where the car really is, for checks: its pose in the world, which is the map
       (the datum is the world's origin), as the bench's /vehicle/bench/truth. Nothing on the
       car's side reads it. -->
  <gazebo>
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>map</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_topic>/model/aav/truth</odom_topic>
      <odom_covariance_topic>/model/aav/truth_with_covariance</odom_covariance_topic>
      <tf_topic>/model/aav/truth/tf</tf_topic>
      <dimensions>3</dimensions>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
  </gazebo>

</robot>
