# pixi run barrier-watch (tools/barrier_watch.py): the road from above, the ghost, its
# keep-out circle, the plan and the car's trail. Outside the capstone's scope (Ben's own
# research, toward his MASc thesis): docs/barriers.md.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (1 m)
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 100
      Alpha: 0.2
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Color Scheme: map
      Draw Behind: true
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Map
      Name: Local costmap (the ghost is in it)
      Enabled: true
      Color Scheme: costmap
      Alpha: 0.4
      Topic:
        Value: /drivers/nav/costmap/local
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Path
      Name: Planned path
      Enabled: true
      Color: 0; 120; 255
      Line Style: Billboards
      Line Width: 0.05
      Topic:
        Value: /plan
    - Class: rviz_default_plugins/Marker
      Name: Ghost
      Enabled: true
      Topic:
        Value: /safety/ghost/marker
    - Class: rviz_default_plugins/Marker
      Name: Keep-out circle (the barrier's, drawn by barrier-watch)
      Enabled: true
      Topic:
        Value: /drivers/nav/track/barrier_watch/keep_out
    - Class: rviz_default_plugins/Polygon
      Name: Stop zone's box
      Enabled: true
      Color: 255; 60; 60
      Topic:
        Value: /safety/stop_zone/box
    - Class: rviz_default_plugins/Odometry
      Name: The car's trail (global EKF)
      Enabled: true
      Keep: 600
      Position Tolerance: 0.2
      Angle Tolerance: 0.05
      Shape:
        Value: Arrow
        Color: 255; 140; 0
        Shaft Length: 0.3
        Shaft Radius: 0.04
        Head Length: 0.12
        Head Radius: 0.1
      Covariance:
        Value: false
      Topic:
        Value: /localization/odom/global
    - Class: rviz_default_plugins/RobotModel
      Name: Car
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Alpha: 0.8
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 28
      Target Frame: map
      X: 17
      Y: 0
