<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aav_bringup</name>
  <version>0.1.0</version>
  <description>Start the whole stack: car.launch.py (real car, per-machine parts from config/machines), sim.launch.py (Gazebo), turtle.launch.py (turtlesim, phase 0), replay.launch.py (re-run localization on a bag). Also the RViz config.</description>
  <maintainer email="aav-team@todo.invalid">AAV 2026-27 team</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>aav_description</exec_depend>
  <exec_depend>aav_command_mux</exec_depend>
  <exec_depend>aav_io_mux</exec_depend>
  <exec_depend>aav_ego</exec_depend>
  <exec_depend>aav_teleop</exec_depend>
  <exec_depend>aav_scripted</exec_depend>
  <exec_depend>aav_drive_to_point</exec_depend>
  <exec_depend>aav_sensors</exec_depend>
  <exec_depend>aav_localization</exec_depend>
  <exec_depend>aav_navigation</exec_depend>
  <exec_depend>aav_ndt</exec_depend>
  <exec_depend>aav_kiss_icp</exec_depend>
  <exec_depend>aav_spine</exec_depend>
  <exec_depend>aav_legacy</exec_depend>
  <exec_depend>aav_turtlesim</exec_depend>
  <exec_depend>aav_gazebo</exec_depend>
  <exec_depend>aav_carla</exec_depend>
  <exec_depend>aav_bench</exec_depend>
  <exec_depend>aav_spine_sim</exec_depend>
  <exec_depend>aav_radar_clusters</exec_depend>
  <exec_depend>aav_detector</exec_depend>
  <exec_depend>aav_camera_stream</exec_depend>
  <exec_depend>aav_hud</exec_depend>
  <exec_depend>aav_lane_geometry</exec_depend>
  <exec_depend>aav_lane_finder</exec_depend>
  <exec_depend>aav_safety</exec_depend>
  <exec_depend>imu_filter_madgwick</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>topic_tools</exec_depend>
  <exec_depend>image_transport</exec_depend>
  <exec_depend>compressed_image_transport</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
