<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aav_localization_health</name>
  <version>0.1.0</version>
  <description>localization_health: warn-only checks on what the EKFs eat and say (gyro bias parked, IMU mounting, GPS quality, timestamps, frames, TF, front wheels, runaway motion), on /localization/health and /diagnostics.</description>
  <maintainer email="aav-team@todo.invalid">AAV 2026-27 team</maintainer>
  <license>TODO</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>aav_interfaces</exec_depend>
  <exec_depend>aav_description</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
