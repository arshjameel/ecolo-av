<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aav_gazebo</name>
  <version>0.1.0</version>
  <description>Gazebo Harmonic backend: worlds (empty, test_lot, road) and their models, the ros_gz bridge configs, and gazebo_adapter, which puts the simulated car behind the same topics as the real one (/control/gazebo/actuator_cmd in, from the output mux; /vehicle/odom, /sensors/imu/data_raw, /sensors/gps/fix, /sensors/radar/points out). The road world renders the car's camera too (/sensors/camera/front_left/image_raw).</description>
  <maintainer email="aav-team@todo.invalid">AAV 2026-27 team</maintainer>
  <license>TODO</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>ackermann_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>aav_interfaces</exec_depend>
  <exec_depend>aav_description</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <!-- spine:=true: the car's spine_bridge, and spine_sim (the spine's own logic). -->
  <exec_depend>aav_spine</exec_depend>
  <exec_depend>aav_spine_sim</exec_depend>
  <exec_depend>aav_legacy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
    <!-- ros_gz_sim's gz_sim.launch.py adds this to GZ_SIM_RESOURCE_PATH: model://stop_sign -->
    <gazebo_ros gazebo_model_path="${prefix}/models"/>
  </export>
</package>
