<?xml version="1.0"?>
<!--
  A 10 m wall, 0.3 m thick and 2 m high: sim_check's narrow street (--three-point, TODO
  174) lines two rows of them. 2 m, so the roof lidar's lowest beam (15 degrees down from
  1.8 m) still meets one 3 m to the side. Its origin is the centre of its base, on the
  ground; it runs along its own x.
-->
<sdf version="1.9">
  <model name="wall">
    <static>true</static>
    <link name="link">
      <pose>0 0 1.0 0 0 0</pose>
      <visual name="visual">
        <geometry><box><size>10 0.3 2</size></box></geometry>
        <material>
          <diffuse>0.6 0.6 0.65 1</diffuse>
          <ambient>0.6 0.6 0.65 1</ambient>
        </material>
      </visual>
      <collision name="collision">
        <geometry><box><size>10 0.3 2</size></box></geometry>
      </collision>
    </link>
  </model>
</sdf>
