<?xml version="1.0"?>
<!--
  Empty world for phase 2: flat ground, nothing in the way. Pairs with the empty map.
  Ravensim reads it (SDF 1.9, as Gazebo did until 16 Nov). The world is named "aav" in
  every file.

  spherical_coordinates puts the world origin on the Earth: it MUST match the datum in
  aav_localization/config/navsat.yaml, so world (x, y) = map (x, y), x east, y north.
-->
<sdf version="1.9">
  <world name="aav">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>45.3860</latitude_deg>
      <longitude_deg>-75.6960</longitude_deg>
      <elevation>70.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>400 400</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>400 400</size></plane></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
