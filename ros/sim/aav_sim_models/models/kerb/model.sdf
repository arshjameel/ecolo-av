<?xml version="1.0"?>
<!--
  A foot-tall kerb: 10 m long, 0.3 m deep, 0.3 m high (TODO 119). The lidar's obstacles
  start 0.3 m above the road (aav_description's GROUND_CLEARANCE), so it sits at the edge of
  what the lidar keeps. sim_check's kerb test (dash dash kerb) lays it across the road.
  Its origin is the centre of its base, on the ground; its long side along x.
-->
<sdf version="1.9">
  <model name="kerb">
    <static>true</static>
    <link name="link">
      <pose>0 0 0.15 0 0 0</pose>
      <visual name="visual">
        <geometry><box><size>10 0.3 0.3</size></box></geometry>
        <material>
          <diffuse>0.6 0.6 0.6 1</diffuse>
          <ambient>0.6 0.6 0.6 1</ambient>
        </material>
      </visual>
      <collision name="collision">
        <geometry><box><size>10 0.3 0.3</size></box></geometry>
      </collision>
    </link>
  </model>
</sdf>
