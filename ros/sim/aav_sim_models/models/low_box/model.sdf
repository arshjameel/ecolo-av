<?xml version="1.0"?>
<!--
  A 0.5 m box: low enough that the roof lidar loses it within about 2.5 m of the bumper
  (its lowest beam is 15 degrees down from 1.8 m). sim_check's low box test (TODO 188)
  places it; the radar is off there, so only the lidar and the costmap's memory see it.
  Its origin is the centre of its base, on the ground.
-->
<sdf version="1.9">
  <model name="low_box">
    <static>true</static>
    <link name="link">
      <pose>0 0 0.25 0 0 0</pose>
      <visual name="visual">
        <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
        <material>
          <diffuse>0.85 0.45 0.1 1</diffuse>
          <ambient>0.85 0.45 0.1 1</ambient>
        </material>
      </visual>
      <collision name="collision">
        <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
      </collision>
    </link>
  </model>
</sdf>
