<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aav_teleop</name>
  <version>0.1.0</version>
  <description>Human drivers. Joystick: joy + teleop_twist_joy publish /drivers/joy/cmd_vel (TwistStamped) into twist_mux, and joy_teleop maps one button to /safety/estop. Keyboard: teleop_twist_keyboard (run by hand, stamped:=true) publishes /drivers/keyboard/cmd_vel. Replaces the 2025-26 joy_teleop_ackerman, which drove the wheels directly.</description>
  <maintainer email="aav-team@todo.invalid">AAV 2026-27 team</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>joy</exec_depend>
  <exec_depend>teleop_twist_joy</exec_depend>
  <exec_depend>joy_teleop</exec_depend>
  <exec_depend>aav_safety</exec_depend>   <!-- joy_alive, joy_alive_impl:=python -->
  <exec_depend>aav_joy_alive_rs</exec_depend>   <!-- joy_alive, the default -->
  <exec_depend>aav_description</exec_depend>   <!-- vehicle.py: joy_alive_impl -->
  <exec_depend>teleop_twist_keyboard</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- test/test_joy_chain.py: the pad -> joy_alive -> teleop -> twist_mux -> ego. -->
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>aav_command_mux</test_depend>
  <test_depend>aav_ego</test_depend>
  <test_depend>aav_ego_rs</test_depend>
  <test_depend>twist_mux</test_depend>
  <test_depend>ackermann_msgs</test_depend>
  <test_depend>sensor_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
