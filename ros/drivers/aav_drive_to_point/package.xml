<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aav_drive_to_point</name>
  <version>0.1.0</version>
  <description>Drive-to-point driver: a DriveToPoint action server that drives to one GPS or map point and stops there, slowing down by the distance left at half the measured braking, publishing /drivers/point/cmd_vel. And its command line client.</description>
  <maintainer email="aav-team@todo.invalid">AAV 2026-27 team</maintainer>
  <license>TODO</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>geographic_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>aav_interfaces</exec_depend>
  <exec_depend>aav_description</exec_depend>
  <exec_depend>aav_actuator_tests</exec_depend>
  <exec_depend>aav_safety</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
