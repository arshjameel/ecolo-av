<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aav_drive_to_point_rs</name>
  <version>0.1.0</version>
  <description>point_driver and drive_to_point in Rust (rclrs): the default since 18 Nov, in place of aav_drive_to_point's Python ones (removed 22 Nov 2026). The same node name, action, topics, QoS and parameters: drive to one point B (lat/lon or map x/y) and stop there. The maths and rules are the point-core crate, with no ROS, checked against the Python modules' answers.</description>
  <maintainer email="aav-team@todo.invalid">AAV 2026-27 team</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- rclrs links rcl; ros-env compiles the Rust message code these packages ship. -->
  <depend>rcl</depend>
  <depend>builtin_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>geographic_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>robot_localization</depend>
  <depend>aav_interfaces</depend>
  <!-- vehicle.yaml, for stop_law hybrid (the car model's brake). -->
  <exec_depend>aav_description</exec_depend>

  <test_depend>ament_cmake_test</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
