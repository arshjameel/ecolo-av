<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aav_navigation</name>
  <version>0.1.0</version>
  <description>Navigation as a driver: our own map server, costmaps, planner, navigator, follower, smoother and stop zone (Nav2's ports; Nav2 deleted 17 Nov), launched as one driver that publishes /drivers/nav/cmd_vel into twist_mux. Their settings (config/nav2.yaml, in Nav2's layout), the lattice primitives, and the maps (empty and example) and their specs.</description>
  <maintainer email="aav-team@todo.invalid">AAV 2026-27 team</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>aav_description</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>aav_lidar</exec_depend>
  <exec_depend>aav_lidar_rs</exec_depend>
  <exec_depend>aav_voxels</exec_depend>
  <exec_depend>aav_things_rs</exec_depend>
  <exec_depend>aav_voxels_rs</exec_depend>
  <exec_depend>aav_ghost</exec_depend>
  <exec_depend>aav_safety</exec_depend>
  <exec_depend>aav_safety_rs</exec_depend>   <!-- stop_hold, the default (stop_hold_impl) -->
  <exec_depend>aav_track</exec_depend>
  <exec_depend>aav_mppi_lag</exec_depend>
  <exec_depend>aav_mpc_lag</exec_depend>
  <exec_depend>aav_smoother</exec_depend>
  <exec_depend>aav_costmap</exec_depend>
  <exec_depend>aav_planner</exec_depend>
  <exec_depend>aav_navigator</exec_depend>
  <exec_depend>aav_stop_zone</exec_depend>
  <exec_depend>aav_behaviour_rs</exec_depend>
  <exec_depend>aav_localization</exec_depend>
  <exec_depend>aav_diffusion_planner</exec_depend>
  <exec_depend>aav_ego</exec_depend>
  <!-- AMCL (amcl:=true, a scored trial): ours; stock nav2_amcl went on 20 Nov. -->
  <exec_depend>aav_amcl_rs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
