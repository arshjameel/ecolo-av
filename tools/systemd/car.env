# What aav-car.service starts on this computer. docs/car-setup.md.
# Installed to ~/.config/aav/car.env by tools/car_setup.sh <role> services, which fills in
# the machine. Edit it there, then: systemctl --user restart aav-car
#
# One KEY=value a line (systemd's EnvironmentFile): no spaces around =, no $VARIABLES, no ~.
#
# The machine file: ros/bringup/aav_bringup/config/machines/<name>.yaml
#   orin, motor_pi, motor_pi_alone (the first moves: the joystick drives, all on the Pi)
AAV_MACHINE=@MACHINE@
# car.launch.py's arguments, space separated. Start slow: 0.3 m/s until the tests say more.
# On stands with no GPS: max_speed:=0.3 stands:=true gps:=false
AAV_CAR_ARGS=max_speed:=0.3
